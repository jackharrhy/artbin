{
  "name": "artbin",
  "private": true,
  "scripts": {
    "publish": "node apps/cli/scripts/publish.mjs",
    "publish:dry-run": "node apps/cli/scripts/publish.mjs --dry-run",
    "release:check": "pnpm exec oxfmt --check apps/cli packages/core packages/ui && pnpm exec oxlint apps/cli packages/core packages/ui && pnpm --filter @artbin/core run ci && pnpm --filter ./apps/cli run ci && pnpm --filter ./apps/cli run build",
    "dev": "pnpm run --filter @artbin/web dev",
    "build": "pnpm run --filter @artbin/web build",
    "start": "pnpm run --filter @artbin/web start",
    "test": "pnpm run --filter @artbin/web test",
    "typecheck": "pnpm -r run ci",
    "ci": "pnpm run format:check && pnpm run lint && pnpm -r run ci",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write apps/ packages/",
    "format:check": "oxfmt --check apps/ packages/",
    "db:migrate": "pnpm run --filter @artbin/web db:migrate",
    "db:push": "pnpm run --filter @artbin/web db:push",
    "db:studio": "pnpm run --filter @artbin/web db:studio",
    "cli:build": "pnpm run --filter ./apps/cli build",
    "cli:dev": "pnpm run --filter ./apps/cli dev"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  },
  "engines": {
    "node": ">=25 <26"
  },
  "packageManager": "pnpm@11.9.0"
}
