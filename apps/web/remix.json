{
  "$schema": "https://remix.run/schemas/remix.json",
  "test": {
    "files": ["app/**/*.remix.test.{ts,tsx}"],
    "exclude": ["node_modules/**", "public/**", "tmp/**"],
    "coverage": {
      "dir": ".coverage",
      "include": ["app/**/*.{ts,tsx}", "src/{db,lib}/**/*.ts"],
      "exclude": ["app/**/*.test.{ts,tsx}"]
    }
  }
}
